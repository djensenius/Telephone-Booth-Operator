{
  "name": "telephone-booth-operator",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run -r --parallel dev",
    "format": "vp fmt",
    "lint": "vp run -r lint",
    "test": "vp run -r test",
    "typecheck": "vp run -r typecheck"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts@<8.0.0": "^8.0.0",
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.6",
      "js-yaml@>=4.0.0 <=4.1.1": "^4.2.0",
      "mysql2@<=3.23.0": "^3.23.1",
      "nanoid@<3.3.18": "^3.3.18",
      "vite@*": "npm:@voidzero-dev/vite-plus-core@0.3.1"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ],
      "allowedVersions": {
        "vite": "*"
      }
    }
  }
}
