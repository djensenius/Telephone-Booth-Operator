# Telephone-Booth-Operator — example environment.
# Copy to .env and fill in real values.

# ─── HTTP ────────────────────────────────────────────────────────────────
API_PORT=8787
WEB_PORT=5173
PUBLIC_API_URL=http://localhost:8787
PUBLIC_WEB_URL=http://localhost:5173

# ─── Database (Postgres) ─────────────────────────────────────────────────
# Docker compose provides a postgres service at db:5432.
DATABASE_URL=postgres://booth:booth@localhost:5432/telephone_booth
# Required when using the single-node profile in docker-compose.prod.yml.
# Generate a strong password: `openssl rand -base64 24`
POSTGRES_PASSWORD=

# ─── Status snapshot retention ───────────────────────────────────────────
# How long to keep historical booth status snapshots (hours). Default: 168 (7 days).
STATUS_SNAPSHOT_RETENTION_HOURS=168
# Minimum number of snapshots to always retain regardless of age. Default: 100.
STATUS_SNAPSHOT_MIN_KEEP=100
# How often the pruner runs (seconds). Default: 3600 (hourly).
STATUS_SNAPSHOT_PRUNE_INTERVAL_SECONDS=3600

# ─── Audit log ───────────────────────────────────────────────────────────
# Record an actor, IP, and timestamp for every write against /v1. Default: true.
AUDIT_LOG_ENABLED=true
# Also record booth telemetry writes (status/system heartbeats, event batches).
# Noisy; off by default.
AUDIT_LOG_TELEMETRY=false
# How long to keep audit entries (days). 0 keeps them forever. Default: 365.
AUDIT_LOG_RETENTION_DAYS=365
# How often the audit pruner runs (seconds). Minimum 300. Default: 21600 (6h).
AUDIT_LOG_PRUNE_INTERVAL_SECONDS=21600

# ─── Azure Blob Storage ──────────────────────────────────────────────────
# Local dev uses Azurite via docker-compose. The connection string below is
# Azurite's well-known default; do NOT use it in production.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
AZURE_BLOB_CONTAINER=booth-recordings
# Production override (uncomment in real .env):
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_BLOB_CONTAINER=booth-recordings
# Optional: minutes a SAS upload URL stays valid.
AZURE_SAS_TTL_MINUTES=15

# Browser origins allowed to send credentials. Comma-separated for multi-host deploys.
WEB_ORIGIN=http://localhost:5173
# Comma-separated reverse proxy IPs/CIDRs whose X-Forwarded-* headers are trusted.
TRUSTED_PROXIES=

# ─── Operator session ────────────────────────────────────────────────────
# Cookie HMAC key. Generate: `openssl rand -hex 32`
SESSION_SECRET=replace-me-with-64-char-random-hex
# AES-256-GCM key for encrypted refresh tokens. Generate: `openssl rand -base64 32`
SESSION_ENCRYPTION_KEY=replace-me-with-32-byte-base64
# Local browser session lifetime. Access tokens may be shorter and are refreshed.
SESSION_TTL_SECONDS=43200
# How often (seconds) an active session is re-checked against the IdP userinfo
# endpoint. Catches accounts deleted in Authentik or removed from the operator
# group: they are signed out within this window instead of lasting the full
# session TTL. Minimum 60; default 300.
SESSION_REVALIDATE_SECONDS=300
# Local development only; never enable in production.
AUTH_DISABLED=false
# Allow HTTP OIDC issuers (development/test only). In production, HTTP
# issuers are rejected at startup unless this is set to true (not recommended).
OIDC_ALLOW_HTTP_ISSUER=false

# ─── OIDC: Authentik (default provider) ──────────────────────────────────
OIDC_PROVIDER_NAME=Authentik
AUTHENTIK_ISSUER=https://authentik.example.com/application/o/telephone-booth-operator/
AUTHENTIK_CLIENT_ID=replace-me
AUTHENTIK_CLIENT_SECRET=replace-me
AUTHENTIK_REDIRECT_URI=http://localhost:8787/v1/auth/callback
AUTHENTIK_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
AUTHENTIK_ALLOWED_GROUPS=telephone-booth-operators

# Operators in an admin group get the elevated **admin** tier: they can manage
# the question catalogue (add/activate/deactivate/delete) and run full data
# export/import. Admin is additive — members must also satisfy the operator
# allow-list above. Leave empty to run with no admins (question management
# becomes unavailable to everyone). Comma-separated; OIDC_ADMIN_GROUPS /
# OIDC_ADMIN_GROUP aliases also work.
AUTHENTIK_ADMIN_GROUPS=telephone-booth-admins

# ⚠️  PRODUCTION REQUIREMENT: At least one of OIDC_ALLOWED_GROUPS /
# AUTHENTIK_ALLOWED_GROUPS or OIDC_ALLOWED_EMAILS / AUTHENTIK_ALLOWED_EMAILS
# must be set in production. The server will refuse to start otherwise.

# ─── OIDC: generic aliases (use these instead of AUTHENTIK_* if you wish) ─
# Any non-empty OIDC_* var overrides its AUTHENTIK_* counterpart.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=
# OIDC_POST_LOGOUT_REDIRECT_URI=
# OIDC_SCOPES=openid email profile offline_access
# OIDC_ALLOWED_GROUPS=telephone-booth-operators
# OIDC_ALLOWED_EMAILS=
# OIDC_ADMIN_GROUPS=telephone-booth-admins
# Comma-separated Authentik client_ids of native/mobile apps that authenticate
# via PKCE against the same provider. Their access-token `aud` claims are
# additionally accepted by the operator bearer-token middleware. The primary
# OIDC_CLIENT_ID above is always accepted.
# OIDC_MOBILE_AUDIENCES=telephone-booth-operator-mobile
# Comma-separated `iss` URLs additionally accepted on mobile bearer tokens.
# Use this when the mobile/native app authenticates against a *separate*
# Authentik provider (different application slug → different issuer URL)
# but shares the primary provider's signing certificate. The primary
# OIDC_ISSUER above is always accepted.
# OIDC_MOBILE_ISSUERS=https://authentik.example/application/o/telephone-booth-operator-mobile/

# ─── Phone-client API token defaults ─────────────────────────────────────
# Bytes of entropy used when generating new tokens (32 = 256 bits).
API_TOKEN_BYTES=32

# ─── Tracing / logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ─── AI: transcription + moderation ──────────────────────────────────────
# Each provider is independently selectable. Default `disabled` keeps the
# pipeline a no-op in dev. See docs/transcription-providers.md.
#
# `push` selects the inverted worker: no in-process provider runs; instead the
# Transcription app (macOS + iOS) subscribes to /v1/ws/status, reacts to `work`
# events, and POSTs results back to /v1/worker/* (see docs/operator-push.md).
# Set TRANSCRIPTION_PROVIDER / TRANSLATION_PROVIDER / MODERATION_PROVIDER to
# `push` to run the whole pipeline on the app. `mac_app` is the older push-in
# mode (Operator calls the app's HTTP server).
#
# Transcription provider: openai | mac_app | push | disabled
TRANSCRIPTION_PROVIDER=disabled
TRANSCRIPTION_OPENAI_MODEL=whisper-1
# mac_app expects an OpenAI-compatible upstream such as the
# Telephone-Booth-Transcription macOS app.
TRANSCRIPTION_MAC_APP_URL=
TRANSCRIPTION_MAC_APP_TOKEN=

# Translation provider: openai | mac_app | push | disabled
TRANSLATION_PROVIDER=disabled
TRANSLATION_OPENAI_MODEL=gpt-4o-mini
# mac_app expects an OpenAI-compatible upstream such as the
# Telephone-Booth-Transcription macOS app.
TRANSLATION_MAC_APP_URL=
TRANSLATION_MAC_APP_TOKEN=

# Moderation provider: openai | mac_app | push | disabled
MODERATION_PROVIDER=disabled
MODERATION_OPENAI_MODEL=omni-moderation-latest
# mac_app expects an OpenAI-compatible upstream such as the
# Telephone-Booth-Transcription macOS app.
MODERATION_MAC_APP_URL=
MODERATION_MAC_APP_TOKEN=

# Shared OpenAI credentials (used for the endpoints above when OpenAI is
# selected). Never commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# Moderation is advisory only: the AI produces a suggestion (approve / review /
# reject) and a human operator always makes the final decision. These thresholds
# only map a moderation score to that human-facing recommendation label; they do
# NOT auto-approve or auto-reject anything.
MODERATION_REJECT_THRESHOLD=0.85
MODERATION_APPROVE_THRESHOLD=0.15

# Recovery sweeper cadence (seconds). The sweeper picks up `received`
# messages that never got transcribed (e.g. after a crash).
AI_SWEEPER_INTERVAL_SECONDS=60

# ─── Audio size / duration limits ─────────────────────────────────────────
# Maximum blob size (bytes) accepted during message completion and before AI
# transcription. Default 25 MiB (26214400) aligns with OpenAI Whisper's cap.
MAX_AUDIO_BYTES=26214400
# Maximum time (seconds) a transcription is allowed to stay pending before
# the sweeper considers it stale and retries. Should exceed the slowest
# expected provider response time.
AI_SWEEPER_STALE_THRESHOLD_SECONDS=300

# ─── Push notifications (APNs) ────────────────────────────────────────────
# Apple Push Notification service credentials for the mobile operator app.
# When any of TEAM/KEY/AUTH_KEY/BUNDLE are unset the sender is a no-op, so
# local dev and CI never emit real pushes. Never commit a real .p8 key.
#
# APNS_TEAM_ID     — your 10-char Apple Developer Team ID.
# APNS_KEY_ID      — the 10-char Key ID of the APNs Auth Key (.p8).
# APNS_AUTH_KEY    — the PEM contents of the .p8 file. In a single-line .env
#                    value, replace newlines with the literal characters \n;
#                    they are normalized back to real newlines at load time.
# APNS_BUNDLE_ID   — the app's bundle id (the watch topic is derived as
#                    "<APNS_BUNDLE_ID>.watch").
# APNS_ENVIRONMENT — "production" (api.push.apple.com) or anything else for
#                    the sandbox (api.sandbox.push.apple.com). Default sandbox.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY=
APNS_BUNDLE_ID=org.davidjensenius.TelephoneBoothOperatorMobile
APNS_ENVIRONMENT=development
