// Telephone-Booth-Operator Prisma schema.
// Datasource: Postgres. ORM: Prisma. Migrations live in prisma/migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

// The connection URL lives in prisma.config.ts (Prisma 7 no longer accepts
// `url` here); the runtime client gets it via the pg driver adapter.
datasource db {
  provider = "postgresql"
}

enum MessageStatus {
  uploading
  received
  pending
  approved
  rejected
}

enum QuestionStatus {
  draft
  active
  archived
}

enum InstructionStatus {
  active
  inactive
}

enum BoothState {
  idle
  dialTone
  dialing
  playingQuestion
  beep
  recording
  uploading
  playingMessage
  playingInstructions
  callUnavailable
  error
}

enum TranscriptionStatus {
  pending
  succeeded
  failed
}

enum ModerationRecommendation {
  approve
  review
  reject
}

enum MessageReviewClassification {
  likely_hangup
  unclear
}

enum MessageReviewRecommendation {
  delete
  review
}

enum RuntimeMode {
  real
  mock
  simulator
}

// Who performed an audited action.
//   operator — a human authenticated via OIDC (cookie session or bearer JWT)
//   apiToken — a machine client presenting a static API token (booth, worker,
//              native operator clients)
//   anonymous — the request carried no usable credential (rejected writes are
//              still recorded so failed attempts leave a trail)
//   system   — an internal, non-request-scoped actor (schedulers, sweepers)
enum AuditActorType {
  operator
  apiToken
  anonymous
  system
}

// A named era of the booth — one run of the installation. At most one row has
// `endedAt IS NULL` at a time (enforced by a partial unique index); that is the
// "active" installation and every new booth write is tagged with it. There is
// none between an era ending and the next booth write, which lazily opens one. Ending an
// installation freezes `summary` so the history list renders without
// re-aggregating the event table per row. See lib/installation.ts.
model Installation {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  notes     String?
  location  String?
  // Nullable means an on-device processor chooses its own language detection.
  // When set, this BCP-47 tag is the installation-wide transcription default.
  defaultTranscriptionLanguage String?
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  endedById String?
  endedBy   OperatorUser? @relation("InstallationEnder", fields: [endedById], references: [id])
  // Counters frozen at end time. Shape is `InstallationSummary` in
  // @telephone-booth-operator/shared. Null while the installation is active.
  summary   Json?
  createdAt DateTime      @default(now())
  // Durable state for the active question ticket bag. The last question id is
  // deliberately scalar-only: questions are archived rather than deleted, and
  // a stale id is harmless when it no longer belongs to the active pool.
  questionSelectionCycle Int     @default(0)
  lastSelectedQuestionId String? @db.Uuid
  // Bounded `{ drawId, questionId }` history used to replay logical draws
  // across retries, including when another draw completes in between.
  recentQuestionDraws     Json    @default("[]")

  messages     Message[]
  callSessions CallSession[]
  events       BoothEvent[]
  snapshots    BoothStatusSnapshot[]
  questions    Question[]

  @@index([startedAt])
  @@index([endedAt])
}

// Latest system telemetry per booth. This is a single-row upsert, not the
// historical metrics store; VictoriaMetrics remains the time-series owner.
model BoothSystemSnapshot {
  boothId    String   @id
  snapshot   Json
  receivedAt DateTime
  version    String?
}

model Question {
  id             String         @id @default(uuid()) @db.Uuid
  prompt         String
  status         QuestionStatus @default(draft)
  // Not unique: copying a question forward into a new installation reuses the
  // same File row (and therefore the same audio blob) rather than cloning it.
  audioId        String         @db.Uuid
  audio          File           @relation(fields: [audioId], references: [id])
  createdAt      DateTime       @default(now())
  retiredAt      DateTime?
  // Weight 1 contributes one ticket per cycle. Higher weights contribute that
  // many tickets while the two cycle fields track durable consumption.
  weight             Int            @default(1)
  lastSelectedCycle  Int?
  selectionsInCycle Int            @default(0)
  messages       Message[]
  // Nullable in the column so the migration never rewrites a large table, but
  // always populated at write time via `requireActiveInstallation()`.
  installationId String?        @db.Uuid
  installation   Installation?  @relation(fields: [installationId], references: [id])

  @@unique([installationId, prompt])
  // One question per audio file per era: sharing exists so a question can be
  // copied *forward*, not so two prompts in the same era can play the same
  // recording. This replaces the global uniqueness the column used to carry.
  @@unique([installationId, audioId])
  @@index([status, createdAt])
  @@index([installationId, status, createdAt])
  @@index([installationId, status, lastSelectedCycle])
  @@index([audioId])
}

model Instruction {
  id          String            @id @default(uuid()) @db.Uuid
  description String?
  status      InstructionStatus @default(active)
  audioId     String            @unique @db.Uuid
  audio       File              @relation(fields: [audioId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([status, createdAt])
}

model Message {
  id             String          @id @default(uuid()) @db.Uuid
  status         MessageStatus   @default(pending)
  notes          String?
  questionId     String?         @db.Uuid
  question       Question?       @relation(fields: [questionId], references: [id])
  audioId        String          @unique @db.Uuid
  audio          File            @relation(fields: [audioId], references: [id])
  createdAt      DateTime        @default(now())
  receivedAt     DateTime?
  decidedAt      DateTime?
  decidedById    String?
  decidedBy      OperatorUser?   @relation(fields: [decidedById], references: [id])
  // No-speech classification is deliberately separate from content moderation.
  // Both values are advisory; DELETE remains an explicit operator action.
  reviewClassification MessageReviewClassification?
  reviewRecommendation MessageReviewRecommendation?
  reviewClassifiedAt   DateTime?
  reviewClassifiedById String?
  reviewClassifiedBy   OperatorUser? @relation("MessageReviewClassifier", fields: [reviewClassifiedById], references: [id])
  // One OIDC-authenticated processor may lease a message at a time. The
  // plaintext token never reaches Postgres; only its SHA-256 digest is stored.
  processingLeaseTokenHash String?
  processingLeaseExpiresAt DateTime?
  processingLeasedAt       DateTime?
  processingLeasedById     String?
  processingLeasedBy       OperatorUser? @relation("MessageProcessingLeaseHolder", fields: [processingLeasedById], references: [id])
  // Hash of the processing-relevant state at claim time. Completion validates
  // it while holding the message row lock, rejecting a result superseded by a
  // pipeline or operator write after the device received the lease.
  processingSnapshotHash   String?
  processingAttemptCount   Int      @default(0)
  processingError          String?
  processingFailedAt       DateTime?
  processingCompletedAt    DateTime?
  transcriptions Transcription[]
  moderations    Moderation[]
  installationId String?         @db.Uuid
  installation   Installation?   @relation(fields: [installationId], references: [id])

  @@index([status, createdAt])
  @@index([installationId, status, createdAt])
  @@index([installationId, status, processingLeaseExpiresAt, createdAt])
  @@index([questionId, createdAt, id])
}

model File {
  id            String       @id @default(uuid()) @db.Uuid
  blobContainer String
  blobKey       String       @unique
  sha256        String       @unique
  sizeBytes     Int
  durationMs    Int?
  contentType   String
  createdAt     DateTime     @default(now())
  questions     Question[]
  instruction   Instruction?
  message       Message?
}

model BoothStatusSnapshot {
  id                Int           @id @default(autoincrement())
  state             BoothState
  currentQuestionId String?       @db.Uuid
  currentMessageId  String?       @db.Uuid
  lastError         String?
  runtimeMode       RuntimeMode?
  // `firstSeenAt` is the first report of this status, `updatedAt` the most
  // recent one, and `repeatCount` how many identical booth reports (heartbeats)
  // have been folded into this row. See `routes/status.ts`.
  firstSeenAt       DateTime      @default(now())
  repeatCount       Int           @default(1)
  updatedAt         DateTime      @default(now())
  installationId    String?       @db.Uuid
  installation      Installation? @relation(fields: [installationId], references: [id])

  @@index([updatedAt])
  // Every heartbeat looks up the run enclosing its own timestamp:
  // `WHERE firstSeenAt <= ? ORDER BY firstSeenAt DESC, id DESC LIMIT 1`.
  @@index([firstSeenAt, id])
  @@index([installationId, updatedAt])
}

// Persistent log of every observable event emitted by a booth (pickup,
// hangup, digit dialed, state transition, recording start/stop, upload
// lifecycle, errors, operator HTTP calls, audio device changes, …).
//
// Booth-supplied `eventId` plus `boothId` form a unique key so the
// `POST /v1/events` bulk endpoint is fully idempotent across retries.
// `recordingId` is a plain string (NOT @db.Uuid) because the booth side
// generates string ids like `recording-{monotonic_ns}`.
model BoothEvent {
  id             String        @id @default(cuid())
  eventId        String
  boothId        String
  bootId         String
  type           String
  occurredAt     DateTime
  receivedAt     DateTime      @default(now())
  sessionId      String?
  recordingId    String?
  payload        Json
  // Running version of the `telephone-booth` Rust client that produced the
  // event (e.g. `0.3.2`). Nullable for backfill / older booths.
  version        String?
  session        CallSession?  @relation(fields: [sessionId], references: [id])
  // Scope tag. Note the `@@unique([boothId, eventId])` idempotency key stays
  // global rather than per-installation: a replayed event must remain deduped
  // even if the retry straddles a rollover.
  installationId String?       @db.Uuid
  installation   Installation? @relation(fields: [installationId], references: [id])

  @@unique([boothId, eventId])
  @@index([occurredAt])
  @@index([boothId, occurredAt])
  @@index([type, occurredAt])
  @@index([sessionId])
  @@index([boothId, receivedAt, id])
  @@index([installationId, occurredAt])
  // The events list is scoped by installation but ordered and paginated by
  // (receivedAt, id), and the console polls it every ten seconds.
  @@index([installationId, receivedAt, id])
}

// Derived from BoothEvent.call_started / call_ended pairs. The booth
// generates `id` as a UUIDv4 on pickup so the operator can group events
// into a session without joining on time windows.
model CallSession {
  id             String        @id
  boothId        String
  bootId         String
  startedAt      DateTime
  endedAt        DateTime?
  digitsDialed   String?
  outcome        String?
  recordingId    String?
  durationMs     Int?
  // Booth client version captured from the `call_started` event.
  version        String?
  events         BoothEvent[]
  installationId String?       @db.Uuid
  installation   Installation? @relation(fields: [installationId], references: [id])

  @@index([boothId, startedAt])
  @@index([outcome])
  // Supports on-idle stale-session reconciliation, which filters open sessions
  // by `endedAt IS NULL AND startedAt <= idleTime` on every idle status write.
  @@index([endedAt, startedAt])
  @@index([installationId, startedAt])
}

// Operator humans authenticated via OIDC (Authentik by default).
// Row is created lazily on first successful login.
model OperatorUser {
  id                      String            @id // Historical internal ID; currently mirrors OIDC `sub`.
  oidcSub                 String            @unique
  email                   String            @unique
  name                    String
  groups                  Json? // raw groups claim at last login
  picture                 String?
  isAdmin                 Boolean           @default(false) // derived from admin-group membership at last login/token check
  firstSeenAt             DateTime          @default(now())
  lastSeenAt              DateTime          @default(now())
  lastLoginAt             DateTime?
  apiTokens               ApiToken[]
  decisions               Message[]
  reviewClassifications   Message[]         @relation("MessageReviewClassifier")
  processingLeases        Message[]         @relation("MessageProcessingLeaseHolder")
  sessions                OperatorSession[]
  requestedTranscriptions Transcription[]   @relation("TranscriptionRequester")
  requestedModerations    Moderation[]      @relation("ModerationRequester")
  mobileDevices           MobileDevice[]
  metricFilters           MetricFilter[]
  endedInstallations      Installation[]    @relation("InstallationEnder")
  auditLogs               AuditLog[]
}

// Per-operator saved metrics filter. Captures a named time selection that can
// be re-applied on the stats screen. Either `window` (a preset) is set, or a
// custom range via `rangeStart`/`rangeEnd`. A null `rangeEnd` means "now".
model MetricFilter {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String
  user       OperatorUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  window     String? // preset window enum value, or null for a custom range
  rangeStart DateTime? // inclusive lower bound; null = from the beginning
  rangeEnd   DateTime? // inclusive upper bound; null = now (live)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
}

model OperatorSession {
  id                   String       @id
  userId               String
  user                 OperatorUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  idToken              String?
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  expiresAt            DateTime
  createdAt            DateTime     @default(now())
  lastSeenAt           DateTime     @default(now())
  lastValidatedAt      DateTime? // last successful re-check of the account against the IdP (userinfo)
  ip                   String?
  userAgent            String?

  @@index([userId])
  @@index([accessTokenExpiresAt])
  @@index([expiresAt])
}

// Persistent identity and latest snapshot for a component telemetry producer.
// API tokens point at this row so a write cannot choose its booth/component
// identity in each request. Prometheus remains the historical sample store.
model TelemetrySource {
  id                 String     @id @default(uuid()) @db.Uuid
  boothId            String
  componentId        String
  displayName        String
  kind               String
  prometheusJob      String
  prometheusInstance String
  latestSnapshot     Json?
  capturedAt         DateTime?
  receivedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  apiTokens          ApiToken[]

  @@unique([boothId, componentId])
  @@index([boothId])
}

// Static API tokens issued to phone-side clients.
// `tokenHash` is Argon2id; plaintext is shown to the operator exactly once.
model ApiToken {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  lookupId        String       @unique
  tokenHash       String
  last4           String
  // Capability scope for the token. "operator" tokens authenticate booth/phone
  // and native operator clients (the historical behaviour); "worker" tokens are
  // limited to the push-worker callback routes and receive only `work` events on
  // the status WebSocket (never `message` envelopes with audio SAS/content);
  // "telemetry" tokens can update only their bound component source.
  scope           String       @default("operator")
  telemetrySourceId String?          @db.Uuid
  telemetrySource   TelemetrySource? @relation(fields: [telemetrySourceId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdBy       OperatorUser @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  auditLogs       AuditLog[]

  @@index([lookupId])
  @@index([revokedAt, expiresAt])
  @@index([createdByUserId, createdAt])
  @@index([telemetrySourceId])
}

// AI transcription attempts. Each re-run inserts a new row (never overwrites
// a previous attempt) so the operator UI can show full history per message.
// Individual rows are updated in-place through their lifecycle:
// pending → succeeded | failed. `provider` and `model` are free-form strings
// so adding new providers does not require a migration. Current values are
// "openai", "mac_app", and "disabled".
model Transcription {
  id            String              @id @default(uuid()) @db.Uuid
  messageId     String              @db.Uuid
  message       Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  provider      String
  model         String?
  status        TranscriptionStatus @default(pending)
  text          String?
  language      String?
  durationMs    Int?
  latencyMs     Int?
  error         String?
  requestedById String?
  requestedBy   OperatorUser?       @relation("TranscriptionRequester", fields: [requestedById], references: [id])
  createdAt     DateTime            @default(now())
  completedAt   DateTime?
  moderations   Moderation[]

  // Translation lives on the same row so we keep one source of truth per
  // transcription attempt. `translationStatus` is null when translation is
  // not required (English audio) or when no translation provider is
  // configured; "pending" while a worker holds the job; "succeeded" /
  // "failed" once a result lands. Translated text is what moderation
  // ultimately runs against if present.
  translationStatus      TranscriptionStatus?
  translatedText         String?
  translatedLanguage     String?
  translationProvider    String?
  translationModel       String?
  translationError       String?
  translationLatencyMs   Int?
  translationCompletedAt DateTime?

  @@index([messageId, createdAt])
  @@index([status, createdAt])
  @@index([status, translationStatus, translationProvider, createdAt(sort: Desc), id(sort: Desc)], map: "Transcription_push_translation_replay_idx")
}

// AI moderation attempts. Linked to the `Transcription` row whose text was
// moderated so we can correlate. We reuse `TranscriptionStatus` for the row
// lifecycle (pending → succeeded | failed).
model Moderation {
  id              String                    @id @default(uuid()) @db.Uuid
  messageId       String                    @db.Uuid
  message         Message                   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  transcriptionId String?                   @db.Uuid
  transcription   Transcription?            @relation(fields: [transcriptionId], references: [id], onDelete: SetNull)
  provider        String
  model           String?
  status          TranscriptionStatus       @default(pending)
  flagged         Boolean?
  recommendation  ModerationRecommendation?
  maxScore        Float?
  categories      Json?
  reasonSummary   String?
  latencyMs       Int?
  error           String?
  requestedById   String?
  requestedBy     OperatorUser?             @relation("ModerationRequester", fields: [requestedById], references: [id])
  createdAt       DateTime                  @default(now())
  completedAt     DateTime?
  pushNotifiedAt  DateTime?

  @@index([messageId, createdAt])
  @@index([recommendation, createdAt])
  @@index([status, provider, createdAt(sort: Desc), id(sort: Desc)], map: "Moderation_push_replay_idx")
}

// Durable singleton state for push conditions that must be coordinated across
// API replicas. Queue-high and moderation badge delivery share one row keyed by
// "moderation-queue-high".
model PushNotificationState {
  key                   String    @id
  active                Boolean   @default(false)
  threshold             Int
  badgeCount            Int       @default(0)
  badgeVersion          Int       @default(0)
  badgeDeliveredVersion Int       @default(0)
  badgeLeaseToken       String?
  badgeLeaseExpiresAt   DateTime?
  updatedAt             DateTime  @updatedAt
}

// Mobile device registered for APNs / push notifications. One row per
// physical device + platform; revoked rows stay in the table with a
// non-null revokedAt so we can track tokens reused after re-install.
model MobileDevice {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String
  user         OperatorUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  apnsToken    String
  platform     String // "ios" | "ipados" | "macos" | "watchos" | "tvos" | "visionos"
  deviceName   String?
  preferences  Json         @default("{}")
  registeredAt DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())
  revokedAt    DateTime?

  @@unique([apnsToken, platform])
  @@index([userId, revokedAt])
}

// Append-only trail of every write action taken against the operator API.
//
// One row per mutating (`POST`/`PUT`/`PATCH`/`DELETE`) `/v1` request, written
// by the `auditWrites()` middleware in `src/lib/audit.ts` after the handler
// runs. Rejected attempts are recorded too — a 403 on a decision endpoint is
// exactly the kind of thing an audit trail exists to capture — so always read
// `statusCode` alongside `action`.
//
// Actor columns are deliberately redundant: `actorUserId` / `actorTokenId` are
// nullable FKs for joins, while `actorLabel` is a denormalized human-readable
// snapshot (operator email, or `token:<name>`) that survives the referenced
// row being deleted or revoked.
//
// Rows are never updated. Retention is enforced by the pruner in
// `src/lib/audit-pruner.ts` (`AUDIT_LOG_RETENTION_DAYS`).
model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  // Dotted, stable action name, e.g. `message.approve`, `question.create`,
  // `auth.login`. Falls back to `http.<method> <route pattern>` for writes a
  // handler did not name explicitly.
  action       String
  // What the action operated on, e.g. `message` + the message id.
  targetType   String?
  targetId     String?
  actorType    AuditActorType
  actorUserId  String?
  actorUser    OperatorUser?  @relation(fields: [actorUserId], references: [id])
  actorTokenId String?        @db.Uuid
  actorToken   ApiToken?      @relation(fields: [actorTokenId], references: [id])
  actorLabel   String
  // Client address. Proxy headers are only trusted when `TRUSTED_PROXIES` is
  // configured; otherwise this is the socket peer address.
  ip           String?
  userAgent    String?
  method       String
  path         String
  statusCode   Int
  // Action-specific detail (decision notes, prior status, counts, …). Never
  // contains secrets, tokens, or SAS URLs.
  metadata     Json?
  createdAt    DateTime       @default(now())

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([ip, createdAt(sort: Desc)])
}
