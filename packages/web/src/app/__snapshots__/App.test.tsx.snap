// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`App shell > matches the themed shell snapshot 1`] = `
<div
  class="booth-frame booth-frame--noise"
>
  <a
    class="skip-link"
    href="#main-content"
  >
    Skip to content
  </a>
  <header
    aria-label="Application header"
    class="telephone-banner"
  >
    <a
      aria-label="Telephone Booth Operator home"
      class="telephone-banner__brand"
      href="/status"
    >
      <span
        class="telephone-banner__copy"
      >
        <span
          class="telephone-banner__eyebrow"
        >
          Operator console
        </span>
        <span
          class="telephone-banner__title"
        >
          Telephone Booth
        </span>
      </span>
    </a>
    <p
      class="telephone-banner__tagline"
    >
      Calls, questions, and system status for the installation.
    </p>
  </header>
  <div
    class="app-shell"
  >
    <aside
      aria-label="Operator navigation"
      class="operator-sidebar"
    >
      <div
        class="booth-status-badge booth-status-badge--idle"
        role="status"
      >
        <span
          aria-hidden="true"
          class="booth-status-badge__dot"
        />
        <span>
          <span
            class="booth-status-badge__label"
          >
            Booth status
          </span>
          <strong>
            Idle
          </strong>
        </span>
      </div>
      <section
        aria-label="Live booth vitals"
        class="system-vitals-strip"
      >
        <header
          class="system-vitals-strip__header"
        >
          <h2>
            Live vitals
          </h2>
          <a
            class="system-vitals-strip__link"
            href="/system"
          >
            Details →
          </a>
        </header>
        <span
          aria-live="polite"
          class="sr-only"
        />
        <div
          class="system-vitals-strip__tiles"
        >
          <div
            class="system-vitals-strip__tile system-vitals-strip__tile--ok"
            title="CPU temperature (warn ≥60°C, crit ≥75°C)"
          >
            <span
              class="system-vitals-strip__tile-label"
            >
              CPU temp
            </span>
            <span
              class="system-vitals-strip__tile-value"
            >
              —
            </span>
          </div>
          <div
            class="system-vitals-strip__tile system-vitals-strip__tile--ok"
            title="Router battery temperature has not been reported"
          >
            <span
              class="system-vitals-strip__tile-label"
            >
              Router battery
            </span>
            <span
              class="system-vitals-strip__tile-value"
            >
              —
            </span>
          </div>
          <div
            class="system-vitals-strip__tile system-vitals-strip__tile--ok"
            title="Average CPU usage across all cores"
          >
            <span
              class="system-vitals-strip__tile-label"
            >
              CPU
            </span>
            <span
              class="system-vitals-strip__tile-value"
            >
              —
            </span>
          </div>
          <div
            class="system-vitals-strip__tile system-vitals-strip__tile--ok"
            title="1-minute load average"
          >
            <span
              class="system-vitals-strip__tile-label"
            >
              Load 1m
            </span>
            <span
              class="system-vitals-strip__tile-value"
            >
              —
            </span>
          </div>
          <div
            class="system-vitals-strip__tile system-vitals-strip__tile--ok"
            title="Memory utilisation"
          >
            <span
              class="system-vitals-strip__tile-label"
            >
              Memory
            </span>
            <span
              class="system-vitals-strip__tile-value"
            >
              —
            </span>
          </div>
          <div
            class="system-vitals-strip__tile system-vitals-strip__tile--ok"
            title="Host uptime since last boot"
          >
            <span
              class="system-vitals-strip__tile-label"
            >
              Uptime
            </span>
            <span
              class="system-vitals-strip__tile-value"
            >
              —
            </span>
          </div>
          <div
            aria-label="Cooling fan: telemetry unavailable"
            class="system-vitals-strip__tile system-vitals-strip__tile--fan"
            role="group"
          >
            <span
              class="system-vitals-strip__tile-label"
            >
              Fan
            </span>
            <div
              class="fan-vital-tile__body"
            >
              <svg
                aria-hidden="true"
                class="fan-vital-tile__dial"
                style="--fan-gauge-progress: 0; --fan-gauge-needle: -90deg;"
                viewBox="0 0 64 38"
              >
                <path
                  class="fan-vital-tile__track"
                  d="M 8 32 A 24 24 0 0 1 56 32"
                  pathLength="100"
                />
                <path
                  class="fan-vital-tile__progress"
                  d="M 8 32 A 24 24 0 0 1 56 32"
                  pathLength="100"
                />
                <circle
                  class="fan-vital-tile__hub"
                  cx="32"
                  cy="32"
                  r="3"
                />
              </svg>
              <div
                class="fan-vital-tile__readout"
              >
                <span
                  class="system-vitals-strip__tile-value"
                >
                  —
                </span>
              </div>
            </div>
            <span
              class="fan-vital-tile__meta"
            >
              Awaiting telemetry
            </span>
          </div>
        </div>
        <footer
          class="system-vitals-strip__footer system-vitals-strip__footer--muted"
        >
          {{VITALS_STATE}}
        </footer>
      </section>
      <nav
        aria-label="Digit shortcut routes"
        class="operator-sidebar__nav"
      >
        <h2>
          Shortcuts
        </h2>
        <ul>
          <li>
            <a
              aria-current="page"
              class="active"
              data-status="active"
              href="/status"
            >
              1 · Status
            </a>
          </li>
          <li>
            <a
              href="/messages"
            >
              2 · Messages
            </a>
          </li>
          <li>
            <a
              href="/questions"
            >
              3 · Questions
            </a>
          </li>
          <li>
            <a
              href="/tokens"
            >
              4 · Tokens
            </a>
          </li>
          <li>
            <a
              href="/settings"
            >
              5 · Settings
            </a>
          </li>
          <li>
            <a
              href="/about"
            >
              6 · About
            </a>
          </li>
          <li>
            <form
              action="/v1/auth/logout"
              method="post"
            >
              <button
                class="operator-sidebar__logout"
                type="submit"
              >
                7 · Logout
              </button>
            </form>
          </li>
          <li>
            <a
              href="/instructions"
            >
              8 · Instructions
            </a>
          </li>
          <li>
            <a
              href="/debug"
            >
              9 · Debug
            </a>
          </li>
          <li>
            <a
              href="/"
            >
              0 · Home
            </a>
          </li>
        </ul>
      </nav>
      <nav
        aria-label="Observability routes"
        class="operator-sidebar__nav"
      >
        <h2>
          Observability
        </h2>
        <ul>
          <li>
            <a
              href="/stats"
            >
              Stats
            </a>
          </li>
          <li>
            <a
              href="/system"
            >
              Live system
            </a>
          </li>
          <li>
            <a
              href="/thermals"
            >
              Thermals
            </a>
          </li>
          <li>
            <a
              href="/events"
            >
              Events
            </a>
          </li>
          <li>
            <a
              href="/sessions"
            >
              Sessions
            </a>
          </li>
          <li>
            <a
              href="/installations"
            >
              Installations
            </a>
          </li>
          <li>
            <a
              href="/audit"
            >
              Audit log
            </a>
          </li>
        </ul>
      </nav>
    </aside>
    <main
      class="app-shell__main"
      id="main-content"
      tabindex="-1"
    >
      <section
        aria-label="Live status panel"
        class="glass-panel feature-screen status-screen"
      >
        <p
          class="screen-kicker"
        >
          Digit 1
        </p>
        <h1>
          Status
        </h1>
        <p>
          The switchboard watches the phone client state machine and keeps the console status in step.
        </p>
        <section
          aria-label="Hook position"
          class="status-indicator status-indicator--on"
        >
          <div>
            <p
              class="screen-kicker"
            >
              Receiver
            </p>
            <strong>
              On hook
            </strong>
            <span>
              idle · since 2025-12-31, 7:00:00 p.m. · updated 2025-12-31, 7:00:00 p.m.
            </span>
          </div>
        </section>
        <details
          class="feature-help"
        >
          <summary>
            What is this?
          </summary>
          <p>
            The phone client reports each state as the handset moves from hook, to dial tone, to question playback, beep, recording, upload, and message playback.
          </p>
        </details>
        <dl
          class="status-grid"
        >
          <div>
            <dt>
              Booth state
            </dt>
            <dd>
              idle
            </dd>
          </div>
          <div>
            <dt>
              Line
            </dt>
            <dd>
              {{LINE_TRANSPORT}}
            </dd>
          </div>
          <div>
            <dt>
              Last error
            </dt>
            <dd>
              Clear
            </dd>
          </div>
        </dl>
        <div
          class="feature-table-wrap"
        >
          <table
            class="feature-table"
          >
            <caption>
              Last 50 booth statuses. The booth repeats its status on a heartbeat, so identical reports are counted rather than listed.
            </caption>
            <thead>
              <tr>
                <th>
                  Time
                </th>
                <th>
                  State
                </th>
                <th>
                  Reports
                </th>
                <th>
                  Question
                </th>
                <th>
                  Message
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <time
                    datetime="2026-01-01T00:00:00.000Z"
                  >
                    2025-12-31, 7:00:00 p.m.
                  </time>
                </td>
                <td>
                  idle
                </td>
                <td
                  title="1 report"
                >
                  ×1
                </td>
                <td>
                  —
                </td>
                <td>
                  —
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
  <footer
    aria-label="Application information"
    class="build-footer"
  >
    <a
      aria-label="Download Telephone Booth Operator on the App Store"
      href="https://apps.apple.com/us/app/telephone-booth-operator/id6775110084"
      rel="noreferrer"
      target="_blank"
    >
      App Store
    </a>
    <span
      aria-hidden="true"
    >
      ·
    </span>
    <span>
      Build date
    </span>
    <time
      datetime="1970-01-01T00:00:00.000Z"
    >
      {{BUILD_DATE}}
    </time>
  </footer>
  <aside
    aria-hidden="true"
    aria-live="assertive"
    class="line-busy-placard"
  >
    <strong>
      LINE BUSY
    </strong>
    <span>
      Switchboard link disconnected
    </span>
  </aside>
</div>
`;
